# Agent settings: place these in apps/agent/.env.
# Use the key for the selected provider; never expose keys to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# chat-latest follows ChatGPT Instant. gpt-* uses OpenAI; claude-* uses Anthropic.
# Model access/availability must be verified with your provider.
# Blank or unsupported model prefixes fail at startup.
# Keys are optional for BYOK-only hosting; visitors enter both keys in the app.
LLM_MODEL=chat-latest

# Jev selects the renderer and visualization before each new user turn.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Frontend settings: place these in apps/app/.env.local.
# LANGGRAPH_DEPLOYMENT_URL defaults to http://localhost:8123.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123
# The stub coach (no model, no keys): make dev-stub, or set both of these.
# LANGGRAPH_DEPLOYMENT_URL=http://127.0.0.1:8123/stub
# NEXT_PUBLIC_COACH_STUB=1
# COACH_HOME holds progress.stub.json; it defaults to ~/.local-ai-coach.
# COACH_HOME=~/.local-ai-coach
# MCP_SERVER_URL=http://localhost:3100/mcp

# No telemetry. The coach's own telemetry and PostHog are removed; this turns
# off the CopilotKit runtime's telemetry (the app's dev and start scripts set it too).
DO_NOT_TRACK=1

# Rate limiting (per IP) — disabled by default
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40
