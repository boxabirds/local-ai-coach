{
  "name": "@repo/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DO_NOT_TRACK=1 bun --watch dev.ts",
    "build": "pnpm --filter @repo/design-system build && bun build.ts",
    "start": "DO_NOT_TRACK=1 bun server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && bun test ./bun-tests",
    "test:e2e": "COACH_STUB=1 COACH_WEB_OUT=dist/web-e2e bun build.ts && playwright test",
    "test:bun": "bun test ./bun-tests"
  },
  "dependencies": {
    "@ag-ui/a2ui-middleware": "^0.0.2",
    "@ag-ui/mcp-apps-middleware": "^0.0.3",
    "@copilotkit/a2ui-renderer": "1.55.2-next.1",
    "@copilotkit/react-core": "1.55.2-next.1",
    "@copilotkit/react-ui": "1.55.2-next.1",
    "@copilotkit/runtime": "1.55.2-next.1",
    "@copilotkitnext/shared": "1.54.1-next.6",
    "@jetbrains/websandbox": "1.2.1",
    "@repo/design-system": "workspace:*",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-rnd": "^10.5.2",
    "react18-json-view": "^0.2.9",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.2.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "bun": "1.2.17",
    "bun-plugin-tailwind": "0.1.2",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.54.0",
    "vitest": "^4.1.8",
    "zod": "^3.23.8"
  }
}
